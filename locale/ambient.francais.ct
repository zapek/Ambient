Aucune
; None
;
MSG_PREFSWIN_ICONDISPLAY_DRIVE_TEXT
Texte
; Text
;
MSG_PREFSWIN_ICONDISPLAY_DRIVE_GAUGE
Jauge
; Gauge
;
MSG_PREFSWIN_ICONDISPLAY_DRIVE_TEXTGAUGE
Texte + jauge
; Text+Gauge
;
MSG_PREFSWIN_ICONDISPLAY_REGTITLE_DESKTOP
Bureau
