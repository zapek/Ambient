;
MSG_PREFSWIN_ICONDISPLAY_REGTITLE_WINDOW
Fenêtre
; Window
;
MSG_PREFSWIN_DRAGDROP_DISPLAYMODE_SOLID
Solide
; Solid
;
MSG_PREFSWIN_DRAGDROP_DISPLAYMODE_CHECKERED
Validé
