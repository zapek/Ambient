AMTD
1
; Wouldn't this be better as ARexx Script / applicationt/x-rexx ?
Name ARexx Source
Type text/x-rexx
Match
	; oh well... this one can become complicated with all the different suffixes out there.
	PatternHint #?.(rx|rexx|amirx|filex|yam)
	Name        #?.(rx|rexx|amirx|filex|yam)
	AND
	Match s/*
	End
Action
	Name Execute with RX...
	Event Menu
	Command AMIGADOS MOSSYS:C/RX %sp
	End
End


AMTD
1
Name Ruby Source
Type text/x-ruby
Match
	PatternHint #?.rb
