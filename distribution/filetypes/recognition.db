AMTD
1
Name OctaMED Module
Type audio/x-octamed
Match
	PatternHint ((med|mmd0|mmd1|mmd2).#?|#?.(med|mmd0|mmd1|mmd2))
	; old format
	MATCH sMED
	OR
	; matches MMD0 - MMD3++
	Match sMMD
	OR
	; multi module files, matches MCNT - MCN1++
	Match sMCN
	End
End


AMTD
1
Name Hippel TFMX Module
Type audio/x-hippel
Priority -100
Match
	PatternHint (hip.#?|#?.hip|hip7.#?|soc.#?)
	(
		Name (hip.#?|#?.hip|hip7.#?|soc.#?)
		AND
		(
			; this is a bit tricky to match as the real magic number
			; (TFMX) is relative to the code (variable size) it follows
			;
			; This matches way too many files and should be fixed.
			;
			; short branch to init/ player routines
			Match $60??60??
			OR
			; long branch to init/ player routines
			Match $6000????6000????
		)
	)
	OR
	; different structure (Hippel V7 most likely)
	(
		Match $6000
		AND
		; "Jochen Hippel"
		Match 20,$4a6f6368656e2048697070656c
	)
	End
End


AMTD
1
Name Hippel TFMX Compact Song Module
Type audio/x-hippelcoso
Match
	; match hipc., hip7., hipst., etc.
	PatternHint (hip#?.#?|#?.#?hip|soc.#?)
	Match sCOSO
	End
End


AMTD
1
Name The Final Musicsystem eXtended Module
Type audio/x-tfmx
Match
	PatternHint mdat.#?|#?.mdat
	; TFMX 7V
	Match sTFMX-SONG
	OR
	Match sTFHD??????????????TFMX-SONG
	OR
	Match stfmxsong
	OR
	; "TFMX "
	Match $54464D5820
	End
End


