	Event DoubleClick
	Command INTERNAL PlaySound %sp VORBIS OPENCONTROL
	End
End


AMTD
1
Name Matroska Audio
Type audio/x-matroska
; must by higher than video/x-matroska
Priority 10
Match
	PatternHint #?.mka
	Name #?.mka
	Match $1A45DFA3
	AND
	{
		Match 8,smatroska
		OR
		Match 32,smatroska
	}
	End
End


AMTD
1
Name Free Lossless Audio Codec File
Type audio/x-flac
Match
	PatternHint #?.flac
	Match sfLaC
	OR
	(
		; FLAC inside Ogg container
		Match sOggS
		AND
		Match 28,sfLaC
	)
	End
End


