AMTD
1
Name PHP Hypertext Preprocessor Source
Type text/x-php
Match
	PatternHint #?.(php|php3|php4)(%|s)
	Match s<?php
	OR
	(
		ContentType Text
		AND
		Name #?.(php|php3|php4)(%|s)
	)
	End
End


AMTD
1
Name Active Server Page Source
Type text/x-asp
Match
	PatternHint #?.asp
	Match s<%
	OR
	(
		ContentType Text
		AND
		Name #?.asp
	)
	End
End


AMTD
1
Name Java Server Page Source
Type text/x-jsp
