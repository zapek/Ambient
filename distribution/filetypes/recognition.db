Match
	PatternHint #?.sln
	Match sMicrosoft?Visual?Studio?Solution?File
	End
End


AMTD
1
Name Microsoft® Developer Studio Resource Script
Type text/x-msdsrc
Match 
	PatternHint #?.rc
	Match s//Microsoft?Developer?Studio?generated?resource?script.
	End
End


