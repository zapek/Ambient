;ARDB\\00737563776d6626646767797f2c5e5a5d404540332935345b7970687e3c757f6c0046435a044149405b07082b
;
;
;  File Format Recognition Database
;  $VER: recognition.db 1.46 (17.02.2024) © 2006-2024 Christian Rosentreter, Harry Sintonen
;
;  Additional Contributions By:
;      Fabien Coerjoly,
;      Nicolas Sallin,
;      Michal Wozniak.
;
;
;  $Id: recognition.db,v 1.70.4.6 2024/02/17 14:38:14 piru Exp $
;

;
;  !!!!!!! DO NOT EDIT THIS FILE !!!!!!!
;
;  You can override or extend all the types from this file with own custom
;  types you place into SYS:Prefs/Ambient/filetypes. If you want to override
;  application/lha for example then you would put an AMTD block to a file named:
;  SYS:Prefs/Ambient/filetypes/application/lha. If your AMTD block contains
;  matching rules it will override the matching rules from recognition.db,
;  the same goes for actions. Usually you only need an AMTD block with actions
;  defined, so Ambient will automatically make use of the proper recognition.db
;  matching rules.
;
;  If you create filetypes you must check if there is already a publicly
;  registered MIME subtype available (http://www.iana.org/assignments/media-types/).
;  If not then some Google research usually points out some commonly used type
;  descriptors. If all fails you just use "x-" prefix like "application/x-openttd-grf"
;  or "x-morphos-" prefix for MorphOS only filetypes like "image/x-morphos-icon".
;
;  Ambient knows about following MIME classes ("Directories of Content-Types"):
;
;  application/   - all kind of binary data files
;  audio/         - audio streams, samples, modules, etc.
;  image/         - pictures, icons, etc.
;  message/       - (mostly irrelevant for Ambient)
;  model/         - 3d objects
;  multipart/     - (mostly irrelevant for Ambient)
;  text/          - ASCII text based formats (source code, guides, etc.)
;  video/         - media files with video stream or video and audio streams
;
;  Do not invent other classes like "archives/" or "modules/" and so on. This is invalid
;  and probably will not work in further versions of Ambient anyway.
;
;
;  All actions defined in recognition.db work with a standard MorphOS installation,
;  so only the tools which come per default with the operating system are supported. Other
;  actions can be easily configured via Ambient preferences in the MIME Editor.
;
;  If you require a certain filetype as default in recognition.db, then mail your
;  request to support@morphos-team.net.
;

;
;  Note: Ambient scans matching rules in reverse order (bottom -> up), so keep
;        stuff with less overhead or no file access at the bottom. "File" and
;        "Directory" followed by "Name" or "Comment" are good candidates here. 
;        Match#? or ContentType should come last (aka: at top) if possible.
; 


;
;  Default naming conventions (English): 
;  
;  - First letter of words in the filetype names are capital, unless the brand or 
;    application name is explicitly written in small letters.
;  - Try to use commonly used name suffixes (see below). Sometimes it only works with 
;    an exception, but usually one of the defined suffixes fits.
;  - Avoid abbreviations if possible (only use them when the name gets too long)
;  - Do not use defined suffixes for files with completely different content to
;    avoid confusion (e.g.: Image <-> Disk Image). If you need then add 'File' at the
;    end.
;
;  */*
;    #? File                     - basic type
;    #? Document                 - read-me files, letters, guides and so on
;    #? Database                 - well.. databases :)
;    #? Compressed File          - single compressed file
;    #? Archive                  - compressed directory (multiple files)
;    #? Font                     - fonts 
;    #? FileSystem               - (mountable) disk images
;    #? Executable               - executable programs
;    #? Script                   - executable scripts
;  audio/*
;    #? Audio                    - basic audio type
;    #? Module                   - pattern based songs (tracker music)
;  image/*
;    #? Image                    - basic image type 
;    #? High Dynamic Range Image - images with >32-bit data 
;  text/*
;    #? Source                   - normal source files
;    #? Header Source            - headers 
;  video/*
;    #? Media File               - audio *and* video data
;    #? Animation                - for old formats only
;    #? Video                    - video data only (avoid this one if possible)
;  model/*
;    #? Object                   - single 3D object
;    #? Scene                    - multiple 3D objects
;  



AMTD
1
Name Global Actions for Files
Type internal/x-morphos-globalaction-file
Match
	End
Action
	Name Open With...
	Event Menu
	Command AMIGADOS Run >NIL: `MOSSYS:C/RequestFile` %sp
	Flag cd source
	End
Action
	Name Create LhA Archive...
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA a -r -a `MOSSYS:C/RequestFile` %sp
	;Command AMIGADOS MOSSYS:C/LhA a -r -a %sp.lha %sp
	Flag cd source
	Flag multiple
	End
Action
	Name Configure Filetype Actions...
	Event Menu
	Command INTERNAL EditMimeType %sp
	End
END


AMTD
1
Name Global Actions for Directories
Type internal/x-morphos-globalaction-directory
Match
	End
Action
	Name Create Archive...
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA a -r -a `MOSSYS:C/RequestFile` %sp
	;Command AMIGADOS MOSSYS:C/LhA a -r -a %sp.lha %sp
	Flag cd source
	Flag multiple
	End
Action
	Name Burn to Disc...
	Event Menu
	Command AMIGADOS Run <>NIL: SYS:Applications/Jalapeno/Jalapeno %sp
	Flag multiple
	End
End


AMTD
1
Name Global Actions for Devices
Type internal/x-morphos-globalaction-device
Match
	End
End



; ===============================================================================================================================
;
;  System internal
;
; ===============================================================================================================================

AMTD
1
Name MorphOS System Directory
Type internal/x-morphos-mossys
Priority 1000
Match
	PatternHint MorphOS
	Comment MorphOS#?
	AND
	Name MorphOS
	AND
	Directory
	End
End


