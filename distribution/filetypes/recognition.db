; -------------------------------------------------------------------------------------------------------------------------------
; filesystems
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name ISO 9660 CD-ROM FileSystem
Type application/x-iso-9660
; make sure it's matched after application/x-nero
Priority -1 
Match
	PatternHint #?.iso
	Match 32769,sCD001
	OR
	Match 37633,sCD001
	End
Action
	Name Open
	Event DoubleClick
	Command INTERNAL loaduri "vfs:///%sp?type=iso" VIEWID %Si
	Flag unquoted
	End
Action
	Name Mount...
	Event Menu
	Command AMIGADOS MOSSYS:S/MountISO %sp OPENVIEW
	End
Action
	Name Burn to Disc...
	Event Menu
	Command AMIGADOS Run <>NIL: SYS:Applications/Jalapeno/Jalapeno %sp
	End
End


AMTD
1
Name High Sierra CD-ROM FileSystem
Type application/x-high-sierra
Match
	PatternHint #?.iso
	Match 37776,sCDROM
	End
End


AMTD
1
Name CD-ROM Raw Image File
Type application/x-cdrwin-bin
; low priority since so generic match
Priority -100
Match
	PatternHint #?.bin
	Name #?.bin
	AND
	FileSize %2352
	End
End


AMTD
1
Name CD-ROM Raw Image Cue Sheet
Type application/x-cdrwin-cue
Match
	PatternHint #?.cue
	Name #?.cue
	AND
	ContentType Text
	AND
	Match iFILE "
	End
End


AMTD
1
Name Nero CD-ROM Image File
Type application/x-nero
; must be matched before application/x-iso-9660
Match
	PatternHint #?.nrg
	Match -20,sEND!????NER5
	OR
	Match -16,sEND!????NERO
	End
End


AMTD
1
Name Amiga Disk File
Type application/x-adf
Match
	PatternHint #?.adf
	FileSize 901120
	AND
	(
		Match $444F53??
		OR
		Match $4B49434B
		OR
		; some ADFs miss "DOS "
		Name #?.adf
	)
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name Extended Amiga Disk File
Type application/x-adfext
Match
	PatternHint #?.adf
	; "UAE-1ADF" (ADF_EXT2)
	Match $5541452D31414446
	OR
	; "UAE--ADF" (ADF_EXT1)
	Match $5541452D2D414446
	OR
	(
		Name #?.adf
		AND
		(
			;; 80 tracks (std adf)
			;;FileSize 901120
			;;OR
			; 81 tracks
			FileSize 912384
			OR
			; 82 tracks
			FileSize 923648
			OR
			; 83 tracks
			FileSize 934912
			OR
			; 80 tracks (HD)
			FileSize 1802240
			OR
			; 81 tracks (HD)
			FileSize 1824768
			OR
			; 82 tracks (HD)
			FileSize 1847296
			OR
			; 83 tracks (HD)
			FileSize 1869824
		)
	)
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


