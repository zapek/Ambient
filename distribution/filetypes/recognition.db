Match
	PatternHint #?.sfv
	Name #?.sfv
	AND
	ContentType Text
	End
End


AMTD
1
Name iCalendar File
Type text/calendar
Match
	PatternHint #?.vcs
	Match iBEGIN:VCALENDAR
	End
End


AMTD
1
Name Electronic Business Card
Type text/x-vcard
Match
	PatternHint #?.vcf
	Match iBEGIN:VCARD
	End
End


AMTD
1
Name Internet Shortcut
Type text/x-url
Match
	PatternHint #?.url
	; normal format
	Match s[InternetShortcut]
	OR
	; extended format
	Match s[DEFAULT]
	OR
	; Sony Ericsson's format
	Match iBEGIN:VBKM
	End
End


AMTD
1
Name Music Module Description
Type text/x-modinfo
Match
	PatternHint #?.mdz
	Match sMODINFO1
	End
End


AMTD
1
Name UU Encoded File
