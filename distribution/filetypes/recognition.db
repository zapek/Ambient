	Event DoubleClick
	Command INTERNAL PlaySound %sp MPEGA OPENCONTROL
	End
End
	

AMTD
1
Name Ogg Vorbis Audio
Type audio/x-vorbis
Priority 0
Match
	PatternHint #?.(ogg|oga)
	Match sOggS
	End
Action
