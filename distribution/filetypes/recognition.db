	Name #?.srt
	AND
	File
	End
End


AMTD
1
Name SubStation Alpha Subtitle File
Type text/x-ssa
Match
	; #?.ass is Advanced format
	PatternHint #?.(ssa|ass)
	; [Script Info]
	Match $5B53637269707420496E666F5D
	OR
	; some files have 3 bytes crap in front, only ninja turtle knows why.
	Match 3,$5B53637269707420496E666F5D
	End
End


AMTD
1
Name VobSub Index File
Type text/x-vobsub-idx
Match
	PatternHint #?.idx
	;# VobSub index file,
	Match $2320566F6253756220696E6465782066696C652C
	End
End


AMTD
1
Name Ambient Filetype Definition
Type text/x-morphos-filetype
Priority 1
Match
	Match sAMTD
	OR
	; some ppl prefer to have an empty line at top
	Match $0a414d5444
	End
End


AMTD
1
Name Ambient Recognition Database
Type text/x-morphos-recognition-db
Match
	PatternHint recognition.db
	Match 1,sARDB
	End
End


AMTD
1
Name Comma Separated Variables File
