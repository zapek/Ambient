; -------------------------------------------------------------------------------------------------------------------------------
;  scripts
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name Perl Script
Type application/x-perl
Match
	PatternHint #?.(pl|cgi)
	Match 2,s/bin/perl
	OR
	Match 3,s/bin/perl
	OR
	Match 2,s/usr/bin/perl
	OR
	Match 3,s/usr/bin/perl
	OR
	Match 3,s/gg/bin/perl
	OR
	Match 2,s/usr/local/bin/perl
	OR
	Match 3,s/usr/local/bin/perl
	End
End


AMTD
1
Name Bourne Shell Script
Type application/x-shellscript-sh
Match
	Match 2,s/bin/sh
	OR
	Match 3,s/bin/sh
	OR
	Match 6,s/bin/sh
	OR
	; boo.. some scripts forgot to use ! ;)
	Match s#/bin/sh
	End
End


AMTD
1
Name Bash Shell Script
Type application/x-shellscript-bash
Match
	Match 2,s/bin/bash
	OR
	Match 3,s/bin/bash
	OR
	Match 2,s/usr/local/bin/bash
	OR
	Match 3,s/usr/local/bin/bash
	End
End


AMTD
1
Name Korn Shell Script
Type application/x-shellscript-ksh
Match
	Match 2,s/bin/ksh
	OR
	Match 3,s/bin/ksh
	End
End


AMTD
1
Name Lua Script
Type application/x-lua
Match
	PatternHint #?.lua
	Name #?.lua
	AND
	ContentType Text
	End
Action
	Name Execute with LuaX...
	Event Menu
	Command AMIGADOS MOSSYS:C/LuaX %sp
	End
End



