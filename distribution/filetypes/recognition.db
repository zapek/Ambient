; ===============================================================================================================================
;
;  video
;
; ===============================================================================================================================

;AMTD
;1
;Name video/*
;Type video/*
;End


AMTD
1
Name Multiple Image Network Graphics
Type video/x-mng
Match
	PatternHint #?.mng
	Match $8A4D4E470D0A1A0A
	End
End


AMTD
1
;Name Audio Video Interleaved Media File
Name AVI Media File
Type video/x-avi
Match
	PatternHint #?.avi
	; "RIFF????AVI "
	Match $52494646????????41564920
	End
End


AMTD
1
Name Matroska Media File
Type video/x-matroska
; needs to be lower than .mka
Priority 0
Match
	PatternHint #?.mkv
	Match $1A45DFA3
	AND
	{
		; This is a bit limited as the string could also
		; appear at other positions depending on other header
		; data, but this should cover most common situations.
		;
		Match 8,smatroska
		OR
		Match 24,smatroska
		OR
		Match 31,smatroska
		OR
		Match 32,smatroska
	}
	End
End


AMTD
1
Name WebM Media File
Type video/webm
Match
	PatternHint #?.webm
	Match $1A45DFA3
	AND
	{
		; This is a bit limited as the string could also
		; appear at other positions depending on other header
		; data, but this should cover most common situations.
		;
		Match 8,iwebm
		OR
		Match 24,iwebm
		OR
		Match 32,iwebm
		OR
		;
		; Oddly enough, this seems to be the most common case.
		Match 31,iwebm
	}
	End
End


AMTD
1
Name MPEG Transport Stream File
Type video/MP2T
Priority -1
Match
	PatternHint #?.ts
	Name #?.ts
	AND
	; Sync byte
	Match $47
	End
End


AMTD
1
Name Ogg Vorbis Media File
Type video/x-vorbis
; needs to be higher than audio/x-vorbis
Priority 100
Match
	PatternHint #?.(ogm|ogv)
	Name #?.(ogm|ogv)
	AND
	Match sOggS
	End
End


AMTD
1
Name MPEG-4 Media File
Type video/mp4
; needs to be higher than quicktime
Priority 10
Match
	PatternHint #?.mp4
	; hmm ? :)
	Match 4,sftyp
	AND
	(
		Match 8,sisom
		OR
		Match 8,smp41
		OR
		Match 8,smp42
		OR
		Match 8,smmp4
	)
	; XXX: more ?
	End
End


AMTD
1
Name 3GPP Media File
Type video/3gpp
; higher than quicktime, because matching for "ftype"
Priority 10
Match
	PatternHint #?.(3gp|3gpp)
	; RFC says there is no magic number, but this
	; seems to work
	Match 4,sftyp3gp
	OR
	(
		ContentType Binary
		AND
		Name #?.(3gp|3gpp)
	)
	End
End


AMTD
1
Name 3GPP2 Media File
Type video/3gpp2
Match
	PatternHint #?.(3g2|3gpp2)
	Name #?.(3g2|3gpp2)
	; RFC says there is no magic number
	AND
	ContentType Binary
	End
End


AMTD
1
Name MPEG Media File
Type video/mpeg
; could match vob and vobsub too, so try to be on the safe
; side and match last.
Priority -1
Match
	PatternHint #?.(mpa|mpe|mpeg|mpg|dat)
	Match $000001BA
	OR
	Match $000001B3
	OR
	Match sRIFF????CDXA
	End
End


AMTD
1
Name DVD Video Object File
; video/dvd is commonly used, but not registered
Type video/dvd
Match
	PatternHint #?.vob
	Name #?.vob
	AND
	Match $000001BA
	End
End


AMTD
1
Name QuickTime® Media File
Type video/quicktime
; needs to be lower than video/mp4, because "Match 4,sftyp"
Priority 0
Match
	PatternHint #?.(mov|qt)
	Match sMOVI
	OR
	Match 4,smoov
	OR
	Match 4,smdat
	OR
	Match 4,sfree
	OR
	Match 4,swide
	OR
	Match 4,sftyp
	OR
	Match 4,spnot
	End
End


AMTD
1
Name Windows® Media File
Type video/x-ms-wmv
Match
	PatternHint #?.(wmv|asf)
	; hmm?
	; this actually matches most (if not all) asf files (including wma)
	Match $3026B2758E66CF11A6D900AA0062CE6C
	End
End

; handled above
;AMTD
;1
;Name Microsoft® ASF Media File
;Type video/x-ms-asf
;Match
;	PatternHint #?.asf
;	Match $3026B275
;	End
;End


AMTD
1
Name IFF Animation
Type video/x-anim
Match
	PatternHint #?.(iff|anim)
	Match sFORM????ANIM
	End
End


AMTD
1
Name IFF YAFA Animation
Type video/x-yafa
Match
	PatternHint #?.(yafa)
	Match sFORM????YAFA
	End
End


AMTD
1
Name Autodesk® Animator Video
Type video/x-flic
Match
	PatternHint #?.(flc|fli|flx|cel|flh|flt)
	; FLI
	Match 4,$11af
	OR
	; FLC (8bit)
	Match 4,$12af
	OR
	; FLIC (!= 8 bit)
	Match 4,$44af
	OR
	; FLIC (Huffman or BWT compressed)
	Match 4,$30af
	OR
	; FLIC (frameshift compression)
	Match 4,$31af
	End
End


AMTD
1
Name Real® Video
Type video/vnd.rn-realvideo
Match
	PatternHint #?.rv
	Match s.RMF
	End
End


AMTD
1
Name MPEG-2 Transport Stream File
Type video/x-mpeg2-ts
Priority -10
Match
	PatternHint #?.ts
	Match $47
	AND
	Match 188,$47
	AND
	Match 376,$47
	AND
	Match 564,$47
	AND
	Match 752,$47
	AND
	Match 940,$47
	AND
	Match 1128,$47
	AND
	Match 1316,$47
	End
End


AMTD
1
Name DeluxePaint Animation
Type video/x-anm
Match
	PatternHint #?.anm
	Match $4C5046200001
	AND
	Match 16,sANIM
	End
End


AMTD
1
; actually it is "Media" (contains sound data too), but use "Video", so it doesn't 
; get confused with normal .swf files that easily.
Name Macromedia® Flash Video
Type video/x-flv
Match
	PatternHint #?.flv
	Match sFLV
	End
End


; ===============================================================================================================================
;
;  model
;
; ===============================================================================================================================

AMTD
1
Name Cinema4D Scene
Type model/x-c4d
Match
	PatternHint #?.c4d
	Match $3643344443344436
	OR
	Match sFORM????MC4DPLTF
	OR
	Match sFORM????MC4DPMMT
	End
End


AMTD
1
Name Plain Text VRML File
Type model/vrml
Match
	PatternHint #?.(wrl|vrml)
	AND
	; "#VRML V1.0 ascii"
	Match $2356524D4C2056312E30206173636969
	End
Action
	Name View with Multiview...
	Event DoubleClick
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
End


AMTD
1
Name Lightwave 3D Object
Type model/x-lwo
Match
	PatternHint #?.(lw|lwo|lwobj)
	Match sFORM????LWOB
	End
End


AMTD
1
Name Lightwave 3D Scene
Type model/x-lws
Match
	PatternHint #?.lws
	Match sLWSC
	End
End


AMTD
1
Name Real 3D Project
Type model/x-real3d
Match
	PatternHint #?.prj
	Match sFORM????REAL
	End
End


AMTD
1
Name Sculpt 3D Scene
Type model/x-sculpt3d
Match
	PatternHint #?.scene
	Match sFORM????SC3D
	End
End


AMTD
1
Name AC3D Scene
Type model/x-ac3d
Match
	PatternHint #?.ac
	Match sAC3D
	End
End


AMTD
1
Name Blender Scene
; Another proposed type is 'application/vnd.blender.blend'
Type model/x-blender
Match
	PatternHint #?.blend
	Match sBLENDER
	End
End


AMTD
1
Name GZip Compressed Blender Scene
Type model/x-blender-compressed
; must be higher than application/gzip
Priority 10
Match
	PatternHint #?.blend
	Name #?.blend
	AND
	Match $1F8B
	End
End


; ===============================================================================================================================
;
;  undefined
;
; ===============================================================================================================================

AMTD
1
Name Temporary File
Type application/x-undefined-temporary
Priority -128
Match
	PatternHint #?.tmp
	Name #?.tmp
	AND
	File
	End
End


AMTD
1
Name Backup File
Type application/x-undefined-backup
Priority -128
Match
	PatternHint #?(.bak|'~|.orig|,old)
	Name #?(.bak|'~|.orig|,old)
	AND
	File
	End
End


AMTD
1
Name Log File
Type application/x-undefined-log
Priority -128
Match
	PatternHint #?(.|_)log
	Name #?(.|_)log
	AND
	File
	End
Action
	Name Open with Multiview...
	Event DoubleClick
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
End


AMTD
1
Name Configuration File
Type application/x-undefined-config
Priority -128
Match
	PatternHint (#?.(conf|prefs|cfg|config)|.#?rc|config)
	Name        (#?.(conf|prefs|cfg|config)|.#?rc|config)
	AND
	File
	End
End


AMTD
1
Name Empty File
Type application/x-undefined-zero
Priority 999
Match
	Name #?
	AND
	FileSize 0
	AND
	File
	End
End
