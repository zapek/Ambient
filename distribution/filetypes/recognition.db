Match
	PatternHint #?.(txt|asc)
	; "begin "
	Match $626567696E20
	End
End


AMTD
1
Name Base64 Encoded File
Type text/x-base64encoded
Match
	PatternHint #?.(txt|asc)
	; "begin-base64 "
	Match $626567696E2D62617365363420
	End
End


