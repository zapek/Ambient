; -------------------------------------------------------------------------------------------------------------------------------
;  archives
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name LhA Archive
Type application/lha
Match
	PatternHint #?.(lha|lzh|lhx)
	Match 2,s-lh?-
	OR
	Match 2,s-lz?-
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
Action
	Name Extract
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA -I x %sp
	Flag cd source
	End
Action
	Name Extract To...
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA -I x %sp `MOSSYS:C/RequestFile DRAWERSONLY TITLE "Select Destination..."`
	Flag cd destination
	End
End


AMTD
1
Name Self-extracting LhA Archive
Type application/x-lharun
Match
	PatternHint #?.run
	Name #?.run
	AND
	(
		; 68k hunk format
		MatchHunk $??
		OR
		; MS-DOS format
		Match sMZ
	)
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
Action
	Name Extract
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA -I x %sp
	Flag cd source
	End
Action
	Name Extract To...
	Event Menu
	Command AMIGADOS MOSSYS:C/LhA -I x %sp %Dp
	; XXX: %D needs to have "/" at end if its not device root, else LhA is picky
	;Command AMIGADOS MOSSYS:C/LhA -I x %sp %D
	;Flag cd destination
	End
End


AMTD
1
Name LZX Archive
Type application/x-lzx
Match
	PatternHint #?.lzx
	; "LZX\0"
	Match $4C5A5800
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name ZIP Archive
Type application/zip
; there are some other ZIP based file formats (OpenDocument, OpenOffice, ...), be lower than them 
; to not catch them away
Priority -10
Match
	PatternHint #?.zip
	; let's only check for the 2 trailing bytes (LE). There are ZIP files with
	; a broken (?) local fileheader signature (e.g. $504b3030) but still can be
	; extracted by unzip and xad.
	Match sPK
	; Match $504b0304
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name ZOO Archive
Type application/x-zoo
Match
	PatternHint #?.zoo
	Match $5A4F4F20
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name Tape Archiver Archive
Type application/tar
Match
	PatternHint #?.tar
	Name #?.tar
	AND
	; should work... unless the first file or directory name in
	; the archive is larger as our internal recognition buffer size :)
	ContentType Binary
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
