AMTD
1
Name Unix Compressed File
Type application/x-compress
Match
	PatternHint #?.(z|taz)
	Match $1F9D
	End
End


AMTD
1
Name GNU Zip Compressed TAR Archive
;Name GZip Compressed TAR Archive
Type application/tgz
; must be higher than application/gzip
Priority 10
Match
	PatternHint #?.(tgz|tar.(gz|gzip))
	Name        #?.(tgz|tar.(gz|gzip))
	AND
	Match $1F8B
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name GNU Zip Compressed File
Type application/gzip
Priority 0
Match
	PatternHint #?.gz
	Match $1F8B
	End
Action
    Name Open
    Event DoubleClick
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
End


AMTD
1
Name BZip2 Compressed TAR Archive
Type application/tbz
; must be higher than application/bzip2
Priority 10
Match
	PatternHint #?.(tbz|tbz2|tar.(bz2|bzip2))
	Name        #?.(tbz|tbz2|tar.(bz2|bzip2))
	AND
	Match $425A68
	End
Action
    Name Open
    Event Menu
    Command INTERNAL loaduri "vfs:///%sp?type=xad" VIEWID %Si
	Flag unquoted
    End
Action
	Name UnCompress with Bz2...
	Event DoubleClick
	Command AMIGADOS Run DETACH PRI -1 MOSSYS:C/Bz2 FROM %sp TO `MOSSYS:C/List %sp LFORMAT "*"%m*""` DECOMPRESS PM
	Flag cd source
	End
End


AMTD
1
Name BZip2 Compressed File
Type application/bzip2
