		OR
		Match $FFF9
	)
	End
End


; -------------------------------------------------------------------------------------------------------------------------------
; trackbased module formats
; -------------------------------------------------------------------------------------------------------------------------------

;AMTD
;1
;Name SoundTracker Module
;Type audio/x-soundtracker
;Priority -20
;Match
;	PatternHint (mod.#?|#?.mod)
;	Name (mod.#?|#?.mod)
;   AND
;   ContentType Binary
;	End
;End


AMTD
1
Name ProTracker Module
Type audio/x-protracker
Match
	PatternHint ((p4#?|mod).#?|#?.(mod|p4#?))
	; 2.3 modules
	Match 1080,sM.K.
	OR
	; 2.3 modules with 64 pattern
	Match 1080,sM!K!
	;
	; packed ones
	;
	OR
	Match sP40A
	OR
	Match sP40B
	OR
	Match sP41A
	OR
	Match sP50A
	OR
	Match sP60A
	OR
	Match sP61A
	End
End


AMTD
1
Name StarTrekker Module
Type audio/x-startrekker
Match
	PatternHint (mod.#?|#?.mod)
	Match 1080,sFLT4
	OR
	Match 1080,sFLT8
	OR
	; hmm ? could be some funky otter tracker too...
	Match 1080,sEXO4
	OR
	Match 1080,sEXO8
	End
End


AMTD
1
Name FastTracker Module
Type audio/x-fasttracker
Match
	PatternHint (mod.#?|#?.mod)
	; 2CHN, 4CHN, 6CHN, 8CHN
	Match 1080,s?CHN
	OR
	; 10CH, 12CH... 30CH, 32CH
	Match 1080,s1?CH
	OR
	Match 1080,s2?CH
	OR
	Match 1080,s3?CH
	End
End


AMTD
1
Name FastTracker eXtended Module
Type audio/x-xm
Match
	PatternHint #?.xm
	; "Extended module:"
	Match $457874656E646564206D6F64756C653A
	OR
	; "Extended Module:"
	Match $457874656E646564204D6F64756C653A
	End
End


AMTD
1
Name TakeTracker Module
Type audio/x-taketracker
Match
	PatternHint (mod.#?|#?.mod)
	Match 1080,s16CN
	OR
	Match 1080,s32CN
	End
End


AMTD
1
Name MultiTracker Module
Type audio/x-multitracker
Match
	PatternHint (mtm.#?|#?.mtm)
	Match sMTM
	End
End


AMTD
1
Name Oktalyzer Module
Type audio/x-octalyzer
Match
	PatternHint ((mod|okt|ok).#?|#?.(ok|okt|mod))
	Match sOKTASONG
	OR
	; atari oktalyzer 8 channel
