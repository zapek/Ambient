	End
End
            

AMTD
1
NAME Catalog Script File
Type text/x-morphos-cs
Match
	PatternHint #?.cs
	NAME #?.cs      
	AND      
	; make sure we don't get false positives with C# source files
	Match s##
	AND
	ContentType Text 
	End
End


AMTD
1
Name Catalog Translation File
Type text/x-morphos-ct
Match
	PatternHint #?.ct
	Name #?.ct
	AND
	Match s##
	End
End


AMTD
1
Name Function Description File
Type text/x-morphos-fd
Match
	PatternHint #?.fd
	Name #?.fd
	AND
	Match s##base
	OR
	Match s##bias
	OR
	Match s*
	End
End


AMTD
1
; XXX: if someone has a better idea for a name ;)
Name UNIX diff Patch File
Type text/x-diff
Match
	PatternHint #?.(patch|diff|diffs)
	(
		; "diff "
		Match $6469666620
		OR
		; "Index: "
		Match $496E6465783A20
		;OR
		; "*** "
		;Match $2a2a2a20
		;OR
		;Match sOnly?in?
		;OR
		;Match sCommon?subdirectories:?
	)
	AND
	ContentType Text
	End
End


AMTD
1
Name Microsoft® Developer Studio Project File
Type text/x-msdsp
Match
	PatternHint #?.dsp
	Match s#?Microsoft?Developer?Studio?Project?File?
	End
End


AMTD
1
Name Microsoft® Visual Studio Solution File
