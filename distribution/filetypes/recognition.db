Name AV1 Image Sequence
Type image/avif-sequence
Match
	PatternHint #?.avifs
	Match 4,sftypavis
	OR
	Match 4,sftypmsf1
End


AMTD
1
Name HEIC Image
Type image/heic
Match
	PatternHint #?.heic
	Match 4,sftypheic
	OR
	Match 4,sftypheix
	OR
	Match 4,sftypheim
	OR
	Match 4,sftypheis
End


AMTD
1
Name HEIC Image Sequence
Type image/heic-sequence
Match
	PatternHint #?.heics
	Match 4,sftyphevc
	OR
	Match 4,sftyphevx
	OR
	Match 4,sftyphevm
	OR
	Match 4,sftyphevs
End


AMTD
1
Name JPEG XL Image
Type image/jxl
Match
	PatternHint #?.jxl
	Match $0000000C4A584C200D0A870A
	OR
	(
		Name #?.jxl
		AND
		Match $FF0A
	)
	End
End


AMTD
1
Name OpenEXR High Dynamic Range Image
Type image/x-openexr
Match
	PatternHint #?.exr
	Match $762F3101
	End
End


AMTD
1
Name Radiance High Dynamic Range Image
Type image/x-radiance
Match
	PatternHint #?.hdr
	Match $233F52414449414E43450A23
	End
End


AMTD
1
Name XCF Image
Type image/x-xcf
Match
	PatternHint #?.xfc
	Match $67696D702078636620
	End
End


; -------------------------------------------------------------------------------------------------------------------------------
; vector formats
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name Scalable Vector Graphics Image
; seems to be the most commonly used type 
Type image/svg+xml
; be higher than generic XML type
Priority 0
Match
	PatternHint #?.svg
	Name #?.svg
	AND	
	; <?xml
	Match $3c3f786d6c
	End
End



; ===============================================================================================================================
;
;  message
;
; ===============================================================================================================================

AMTD
1
Name Multipurpose Internet Mail Extension HTML File
; it's actually a normal MIME file (message/rfc822), but we make it a subtype as with the mht suffix it has special meaning 
; and slightly different requirements
Type message/x-mhtml
Match
	PatternHint #?.mh(t|tml)
	Name #?.mh(t|tml)
	AND
	ContentType Text
	AND
	(
		; probably needs to be extended
		Match sContent-Type:
		OR
		Match sMIME-Version:
	)
	End
Action
	Name Open with Multiview...
	Event DoubleClick
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
End



; ===============================================================================================================================
;
;  text
;
; ===============================================================================================================================

AMTD
1
Name text/*
Type text/*
;Action
;	Name Open
;	Event DoubleClick
;	Command INTERNAL LoadURI %sp
;	End
Action
	Name Multiview...
	Menu Open With
	Event Menu
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
Action
	Name More...
	Menu Open With
	Event Menu
	Command WORKBENCH SYS:Utilities/More %sp
	End
Action
	Name Edit...
	Event Menu
	COMMAND WORKBENCH MOSSYS:C/Ed %sp
	End
End



; -------------------------------------------------------------------------------------------------------------------------------
; document oriented
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name Text Document
Type text/plain
; should always be matched as very last (even after internal types)
Priority -600
Match
	PatternHint (#?.(txt|doc|dok|readme|text|notes|nfo|license|diz)|#?readme#?|todo#?|copying|news|install|history|license|authors|bugs|changelog#?|changes|liesmich)
	; XXX: this "Name ..." suxx, but if it is disabled then Ambient detects too much other recognized types as text atm.
	;      (priority sorting in recog stuff needs improvements)
	;Name        (#?.(txt|doc|dok|readme|text|notes|nfo|license|diz)|#?readme#?|todo#?|copying|news|install|history|license|authors|bugs|changelog#?|changes|liesmich)
	;AND
	ContentType Text
	End
End


AMTD
1
Name Rich Text Format Document
Type text/rtf
Match
	PatternHint #?.(rtf|rtx|doc)
	Match s{\rtf
	End
End


AMTD
1
Name HTML Document
Type text/html
Match
	; shtml is not really a document, but a source... but what the dell :)
	PatternHint #?.(html|htm|shtml)
	(
		ContentType Text
		AND
		Name #?.(html|htm|shtml)
	)
	OR
	; detect some html files w/o the proper suffix in 2nd run
	(
		Match i<!DOCTYPE?HTML
		OR
		Match i<html
		OR
		Match s<!--
	)
	End
Action
	Name Open with OpenURL...
	Event DoubleClick
	Command AMIGADOS MOSSYS:C/OpenURL %sp FILE NEWWIN
	End
End


AMTD
1
Name XML Document
Type text/xml
; must be lower than other non-generic XML types (abiword, etc.)
Priority -1
Match
	PatternHint #?.xml
	; <?xml
	Match $3c3f786d6c
	OR
	; UTF-16, big endian
	Match $feff003c003f0078006d006c
	OR
	; UTF-16, little endian
	Match $ffef3c003f0078006d006c00
	End
End


AMTD
1
Name AmigaGuide® Document
Type text/x-amigaguide
Match
	PatternHint #?.(guide|aguide|ag|amigaguide)
	Match i@DATABASE
	End
Action
	Name Multiview...
	Event Doubleclick
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
Action
	Name Edit...
	Event Menu
	COMMAND WORKBENCH MOSSYS:C/Ed %sp
	End
End


AMTD
1
Name Autodoc Document
Type text/x-morphos-autodoc
Match
	PatternHint #?.doc
	Match sTABLE?OF?CONTENTS
	End
End


AMTD
1
Name AbiWord Document
; XXX: seems to be the most common used type, but maybe should go to application/
Type text/x-abiword
; must be higher than generic XML type
Priority 0
Match
	PatternHint #?.(abw|awt)
	; I only found documents with UTF-8 encoding, so possibly the DOCTYPE marker could appear
	; on other positions too, depending on the encoding used in the document
	Match 39,i<!DOCTYPE?abiword
	End
End


AMTD
1
Name LaTeX Document
Type text/x-tex
Match
	PatternHint #?.tex
	Name #?.tex
	AND
	ContentType Text
	End
End


AMTD
1
Name Standard Generalized Markup Language Document
Type text/sgml
Match
	PatternHint #?.sgml
	Match i<!doctype?refentry?PUBLIC?"
	AND
	ContentType Text
	End
End


