; ===============================================================================================================================
;
;  audio
;
; ===============================================================================================================================

AMTD
1
Name audio/*
Type audio/*
;Action
	;Name Play...
	;Event DoubleClick
	;Command INTERNAL PlaySound %sp DATATYPE OPENCONTROL
	;End
Action
	Name Play with MultiView...
	Event Menu
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
End



; -------------------------------------------------------------------------------------------------------------------------------
; internet oriented formats (compressed streams)
; -------------------------------------------------------------------------------------------------------------------------------

AMTD
1
Name MPEG Layer-3 Audio
Type audio/mpeg
Match
	PatternHint #?.mp3
	Match $49443303
	OR
	{
		ContentType Binary
		AND 
		Name #?.mp3
	}
	End
Action
	Name Play...
	Event DoubleClick
	Command INTERNAL PlaySound %sp MPEGA OPENCONTROL
	End
End


AMTD
1
Name MPEG Layer-2 Audio
Type audio/x-mp2
Match
	PatternHint #?.mp2
	ContentType Binary
	AND 
	Name #?.mp2
	End
Action
	Name Play...
	Event DoubleClick
	Command INTERNAL PlaySound %sp MPEGA OPENCONTROL
	End
End


AMTD
1
Name Musifile MPEG Layer-2 Audio
