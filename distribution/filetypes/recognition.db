; ===============================================================================================================================
;
;  image
;
; ===============================================================================================================================

AMTD
1
Name image/*
Type image/*
;Action
;    Name View
;    Event DoubleClick
;    ; only works as doubleclick event, we need some smarter command
;    ; here... like LoadURIInternal or such. :)
;    Command INTERNAL LoadURI %sp
;    End
Action
	Name Multiview...
	Menu View With
	Event Menu
	Command WORKBENCH SYS:Utilities/Multiview %sp
	End
Action
	Name ShowCase...
	Menu View With
	Event Menu
	Command WORKBENCH SYS:Applications/ShowCase/ShowCase %sp
	End
Action
	Name Mysticview...
	Menu View With
	Event Menu
	Command WORKBENCH SYS:Utilities/MysticView %sp
	End
Action
	Name Edit with Sketch...
	Event Menu
	Command AMIGADOS Run DETACH SYS:Applications/Sketch/Sketch %sp
	End
End


AMTD
1
Name Icon File
Type image/x-morphos-icon
Match
	PatternHint #?.info
	Name #?.info
	AND
	(
		Match $89504E470D0A1A0A
		OR
		Match $E3100001
	)
	End
;
; XXX: w/o this action Ambient tries to show .info files with a possible default tool
;      set in them which can cause weird effects if these programs don't handle .info
;      files ;)
;
Action
	Name Open
	Event DoubleClick
	Command INTERNAL iconinfo %sp
	End
End


