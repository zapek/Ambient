; type specification seems to be marked as 'obsolete' too, but still in use
Type application/vnd.sun.xml.writer
; must be lower than OpenDocument, but higher than normal zip type
Priority -2
Match
	PatternHint #?.(sxw|stw)
	Match sPK
	AND
	Match 30,smimetypeapplication/vnd.sun
	End
End



