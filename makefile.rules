#
# $Id: makefile.rules,v 1.19 2026/02/08 13:42:00 kronos Exp $
#

#
# Revision
#
rev.h: .revinfo
	$(OUT)$(SOURCE)rev DIRECTORY=../../ $(QUIET)

copyright.h: rev.h

#
# Catalog
#

catalogs: $(CATOBJ)

locale/ambient.%.catalog: locale/ambient.cd locale/ambient.%.ct
	$(ECHO) "FLEXCAT $(notdir $<) -> $@"
	$(OUT)$(FLEXCAT) locale/ambient.cd locale/ambient.$*.ct CATALOG=locale/ambient.$*.catalog

ambient_cat.h: locale/ambient.cd catmaker
	$(ECHO) "CATMAKER $(notdir $<) -> $@"
	$(OUT)$(CATMAKER) ../../locale/ambient.cd ambient_cat.h CFILE $(QUIET)
	$(OUT)$(DELETE) cattmp.c

ambient_cat.o: ambient_cat.h catmaker
	$(ECHO) "CATMAKER $(notdir $<) -> $@"
	$(OUT)$(CATMAKER) ../../locale/ambient.cd $(TMPDIR)/ambient_cat.h CFILE
	$(OUT)$(DELETE) $(TMPDIR)/ambient_cat.h
	$(OUT)$(CC) $(CFLAGS) -c -o ambient_cat.o cattmp.c

catmaker: catmaker.c
	$(OUT)$(HOSTCC) $(HOSTCFLAGS) -c $(SOURCE)catmaker.c
	$(OUT)$(HOSTCC) $(HOSTLDFLAGS) -o catmaker catmaker.o

#
# Imagery stuff
#
%_logo.h : images/%.png
	$(ECHO) "PNG2C $(notdir $<) -> $(notdir $@)"
	$(OUT)${SOURCE}png2c ../../images/$*.png $(TMPDIR)$*_logo.c $*_logo.h $(QUIET)
	$(OUT)$(DELETE) $(TMPDIR)*_logo.c

%_logo.o : images/%.png
	$(ECHO) "PNG2C $(notdir $<) -> $(notdir $@)"
	$(OUT)${SOURCE}png2c ../../images/$*.png $*_logo.c $(TMPDIR)$*_logo.h $(QUIET)
	$(OUT)$(DELETE) $(TMPDIR)$*_logo.h
	$(OUT)$(CC) $(CFLAGS) $*_logo.c
	

#
# Always up-to-date revisions information for devel and nightly builds 
# (w/o need to make clean or touch the related files)
#
REVSTRINGCFILE = "/tmp/ambient_rev_strings.c"

rev_strings.o: $(COBJS)
	$(ECHO) "CC revstrings.c"
	$(OUT)echo "/*  Do not edit this file by hand!" >$(REVSTRINGCFILE)
	$(OUT)echo " *  It's recreated on each build automatically (when required)." >>$(REVSTRINGCFILE)
	$(OUT)echo " */" >>$(REVSTRINGCFILE)
	$(OUT)echo >>$(REVSTRINGCFILE)
	$(OUT)echo "#include <exec/types.h>" >>$(REVSTRINGCFILE)
	$(OUT)echo >>$(REVSTRINGCFILE)
	$(OUT)echo >>$(REVSTRINGCFILE)
	$(OUT)echo -n "CONST_STRPTR __screentitle_additional = " >>$(REVSTRINGCFILE)
ifeq ($(RELEASE), BETA_RELEASE)
ifeq ($(NIGHTLY), 1)
	$(OUT)echo -n "\"  [ nightly build: $(shell date "+%d.%m.%Y") $(shell date "+%T") ]\"" >>$(REVSTRINGCFILE)
else
	$(OUT)echo -n "\"  [ GCC v$(shell $(CC) -dumpversion) · development build: $(shell date "+%d.%m.%Y") $(shell date "+%T") · $(shell whoami) ]\"" >>$(REVSTRINGCFILE)
endif
else
ifeq ($(RELEASE), SHOW_RELEASE)
	$(OUT)echo -n "\"  [ special computer show version ]\"" >>$(REVSTRINGCFILE)
else
	$(OUT)echo -n "NULL" >>$(REVSTRINGCFILE)
endif
endif
	$(OUT)echo ";" >>$(REVSTRINGCFILE)
	$(OUT)echo >>$(REVSTRINGCFILE)
	$(OUT)$(CC) $(CFLAGS) -DBASE_NAME=\"$(notdir $<)\" -c -o $@ $(REVSTRINGCFILE) $(GCCMSG)
	$(OUT)$(RM) $(REVSTRINGCFILE)


#
# Stubs for varargs68k functions
#
$(SOURCE)$(BUILDDIR)/lib/libvambient.a: ../../varargs68k.h
	$(ECHO) "Generating stubs"
	../../scripts/stubgen.pl --clib ../../varargs68k.h --gluelib $(SOURCE)$(BUILDDIR)/lib/libvambient.a --quiet

#
# General
#
altivec.o : altivec.c
	$(ECHO)	"CC $(notdir $<)"
	$(OUT)$(CC) $(CFLAGS) $(CFLAGSVEC) -DBASE_NAME=\"$(notdir $<)\" $< $(GCCMSG)

%_vec.o : %_vec.c
	$(ECHO)	"CC $(notdir $<)"
	$(OUT)$(CC) $(CFLAGS) $(CFLAGSVEC) -DBASE_NAME=\"$(notdir $<)\" $< $(GCCMSG)

%.o : %.c
	$(ECHO)	"CC $(notdir $<)"
	$(OUT)$(CC) $(CFLAGS) -DBASE_NAME=\"$(notdir $<)\" $< $(GCCMSG)

%.o : %.s
	$(ECHO) "AS $(notdir $<)"
	$(OUT)$(CC) $< -o $@ $(GCCMSG)

#
# tcrypt
#
tcrypt: tcrypt.c
	$(OUT)$(HOSTCC) $(HOSTCFLAGS) $< -o $@

#
# rev
#
rev: rev.c
	$(OUT)$(HOSTCC) $(HOSTCFLAGS) $< -o $@

#
# createtimeout
#
createtimeout: createtimeout.c
	$(OUT)$(HOSTCC) $(HOSTCFLAGS) $< -o $@

ifeq ($(LIBPNG),1)
#
# pnglib stuff
#
libs/pnglib/ppcinline/png.h:
	$(OUT)$(MAKE) $(NODIR) $(SILENT) -C $(SOURCE)libs/pnglib ppcinline/png.h
endif

ifeq ($(LIBZ),1)
#
# zlib stuff
#
libs/zlib/ppcinline/z.h:
	$(OUT)$(MAKE) $(NODIR) $(SILENT) -C $(SOURCE)libs/zlib ppcinline/z.h
endif

#
# about stuff
#
modules/about/ppcinline/about.h:
	$(OUT)$(MAKE) $(NODIR) $(SILENT) -C $(SOURCE)modules/about ppcinline/about.h

#
# abouttext
#
cryptstr.h: cryptstr.o

cryptstr.o: default_cryptstr.c tcrypt cryptstr.txt
	$(OUT)$(COPY) ../../default_cryptstr.c cryptstr.c
	$(ECHO) "CRYPT $(notdir $<) -> $@"
	$(OUT)./tcrypt ../../cryptstr.txt cryptstr.c cryptstr.h
	$(OUT)$(CC) $(CFLAGS) $*.c

#
# panel
#
panel: ambient_includes
	cd panel; make -f makefile all
	cd panelprefs; make -f makefile all

#
# create provisional includes for ambient.library
#

ambient_includes: includes-private/fd/ambient_lib.fd  includes-private/proto/ambient.h includes-private/ppcinline/ambient.h 

includes-private/fd/ambient_lib.fd: ambient_lib.c
	@mkdir -p includes-private/fd
ifeq ($(shell uname), MorphOS)
	genfd.pl ambient_lib.c > includes-private/fd/ambient_lib.fd
else
	../development/tools/genfd/genfd.pl ambient_lib.c > includes-private/fd/ambient_lib.fd
endif

includes-private/proto/ambient.h:  ambient_lib.c
	@mkdir -p includes-private/proto
	cvinclude.pl --fd includes-private/fd/ambient_lib.fd --proto $@

includes-private/ppcinline/ambient.h:  ambient_lib.c includes-private/clib/ambient_protos.h
	@mkdir -p includes-private/ppcinline
	cvinclude.pl --fd includes-private/fd/ambient_lib.fd --clib includes-private/clib/ambient_protos.h --inline $@

